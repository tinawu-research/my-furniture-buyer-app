# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed to run scripts/sync-products.mjs (loads the product catalogue).
# Service role key: Project Settings > API > "service_role" secret. Never expose
# this to the browser — it bypasses all database security rules.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed to run scripts/sync-products.mjs. Given to you by the hackathon organizers.
MONGODB_URI=mongodb+srv://user:password@your-cluster.mongodb.net/catalog?appName=Hackathon
