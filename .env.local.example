# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed to run scripts/sync-products.mjs (loads the product catalogue).
# Service role key: Project Settings > API > "service_role" secret. Never expose
# this to the browser — it bypasses all database security rules.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed to run scripts/sync-products.mjs. Given to you by the hackathon organizers.
MONGODB_URI=mongodb+srv://user:password@your-cluster.mongodb.net/catalog?appName=Hackathon

# Level 2: external Product Search API. Base URL, User ID and API key all
# come from the organizers / the credentials page — never hardcode the key
# in source, and never send it to the browser (no NEXT_PUBLIC_ prefix).
EXTERNAL_API_BASE_URL=https://example.training.cognitivo.com.au
EXTERNAL_API_USER_ID=u001
EXTERNAL_API_KEY=your-api-key

# Shop assistant agent's LLM (Azure-hosted GPT-5 mini) — also organizer-issued
# for Day 1; same rule applies (never commit, screenshot, or reuse it elsewhere).
AZURE_AI_ENDPOINT=https://your-resource.api.cognitive.microsoft.com/
AZURE_AI_API_VERSION=2024-12-01-preview
AZURE_AI_DEPLOYMENT=gpt-5-mini
AZURE_AI_API_KEY=your-azure-api-key
